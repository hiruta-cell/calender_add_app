# 依存関係のバージョンを固定して保存する（^ や ~ を付けない）
save-exact=true
# package.json の engines（Node.js のバージョン条件）を満たさない環境ではインストールを止める
engine-strict=true
# 寄付の案内表示を出さない
fund=false
# 部品のインストール時スクリプト（preinstall / install / postinstall）を実行しない。
# 現在の部品には必要なものがなく、乗っ取られた部品の不正なスクリプトがインストール時に動くのを防ぐため。
# （npm start / npm test などの、明示的に実行するコマンドには影響しない）
ignore-scripts=true
