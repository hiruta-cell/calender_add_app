# 依存関係・ビルド成果物
node_modules/
dist/
out/
build/
release/

# 秘密情報（このアプリは本来不要だが、誤コミット防止のため除外）
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.crt
credentials*.json
token*.json
secrets*

# OS・エディタ
.DS_Store
Thumbs.db
.vscode/
.idea/

# ログ・一時ファイル
*.log
npm-debug.log*
.cache/
tmp/

# 確認スクリプト（npm run test:smoke）が保存する画面の画像
test-results/

# Mac の起動用アプリ（設定画面の「デスクトップにアイコンを作る」で、PC ごとのパスを入れて作る）
launcher/

# 取り込み画像・実メール（個人情報の混入防止）
captures/
*.png.tmp

